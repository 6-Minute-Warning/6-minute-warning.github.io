rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(email());
    }

    function isOwner() {
      return signedIn() && email() == 'brett@6minutewarning.com';
    }

    function isMember() {
      return signedIn() && (isOwner() || exists(userDoc()));
    }

    function isManager() {
      return isOwner() || (isMember() && get(userDoc()).data.role in ['admin', 'manager']);
    }

    function isDirector() {
      return isMember() && get(userDoc()).data.role == 'director';
    }

    function isAdmin() {
      return isOwner() || (isMember() && get(userDoc()).data.role == 'admin');
    }

    function isScheduler() {
      return isManager() || (isMember() && 'scheduler' in get(userDoc()).data.get('duties', []));
    }

    function isAssistant() {
      return signedIn() && !isOwner() && exists(userDoc()) && get(userDoc()).data.role == 'assistant';
    }

    function isSinger() {
      return isMember() && !isAssistant();
    }

    function validUser() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'role', 'person', 'duties', 'addedAt', 'addedBy'])
        && (!('person' in d) || (d.person is string && d.person.size() <= 80))
        && (!('duties' in d) || (d.duties is list && d.duties.hasOnly(['scheduler'])))
        && d.role in ['admin', 'manager', 'director', 'member', 'assistant']
        && d.name is string && d.name.size() <= 120;
    }

    match /users/{userEmail} {
      allow get: if signedIn() && userEmail == email();
      allow get: if isMember();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && userEmail == userEmail.lower() && validUser()
        && (userEmail != email() || request.resource.data.role == 'admin');
      allow delete: if isAdmin() && userEmail != email();
    }

    function abandons() {
      return request.resource.data.stage == 'cancelled' && request.resource.data.call.abandoned == true;
    }

    function wasAbandoned() {
      return 'call' in resource.data && resource.data.call.abandoned == true;
    }

    function validCall() {
      let c = request.resource.data.call;
      return !('call' in request.resource.data) || (
        c is map
        && c.keys().hasOnly(['openedBy', 'openedAt', 'asked', 'subbing', 'abandoned', 'calendarEventId'])
        && c.asked is list && c.asked.size() <= 40
        && c.subbing is list && c.subbing.size() <= 40
        && c.abandoned is bool
        && c.calendarEventId is string);
    }

    function validRehearsals() {
      let r = request.resource.data.rehearsals;
      return !('rehearsals' in request.resource.data) || (
        r is map
        && r.keys().hasOnly(['needed', 'note', 'by', 'at', 'lineupKey'])
        && r.keys().hasAll(['needed', 'note', 'by', 'at', 'lineupKey'])
        && r.needed is int && r.needed >= 0 && r.needed <= 20
        && r.note is string && r.note.size() <= 200
        && r.by == email()
        && r.at == request.time
        && r.lineupKey is string && r.lineupKey.size() <= 2000);
    }

    function rehearsalsOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rehearsals'])
        || ((isManager() || isDirector()) && 'rehearsals' in request.resource.data && validRehearsals());
    }

    function short(value, max) {
      return value is string && value.size() <= max;
    }

    function isDay(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validRequest(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'date', 'dateOptions', 'time', 'venue', 'stage', 'notes', 'contact', 'money', 'contract', 'performers', 'soundTech', 'sets', 'outfit', 'call', 'createdAt', 'createdBy', 'via'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && isDay(d.date)
        && (!('dateOptions' in d) || validOptions(d.dateOptions, d.date))
        && short(d.time, 80) && short(d.venue, 160) && short(d.notes, 2000) && short(d.sets, 60)
        && (!('outfit' in d) || d.outfit in ['suits-blue', 'suits-white', 'casual', 'both'])
        && d.contact.keys().hasOnly(['name', 'email', 'phone'])
        && short(d.contact.name, 120) && short(d.contact.email, 160) && short(d.contact.phone, 40)
        && d.stage == 'tentative' && d.contract == 'none' && d.performers == [] && d.soundTech == ''
        && d.money.keys().hasOnly(['fee', 'deposit', 'paid', 'merch', 'perSinger'])
        && d.money.fee is int && d.money.fee >= 0 && d.money.perSinger is int && d.money.perSinger >= 0
        && d.money.deposit == 0 && d.money.paid == 0 && d.money.merch == 0
        && d.createdBy == email() && d.createdAt == request.time && d.via == 'assistant'
        && (!('call' in d) || (d.call.openedBy == email() && d.call.abandoned == false && d.call.subbing == []))
        && getAfter(/databases/$(database)/documents/tasks/$('request-' + id)).data.createdAt == request.time;
    }

    function validOptions(o, date) {
      return o is list && o.size() >= 2 && o.size() <= 6 && o[0] == date
        && isDay(o[1]) && (o.size() < 3 || isDay(o[2])) && (o.size() < 4 || isDay(o[3]))
        && (o.size() < 5 || isDay(o[4])) && (o.size() < 6 || isDay(o[5]));
    }

    function validDateOptions() {
      let d = request.resource.data;
      return !('dateOptions' in d) || validOptions(d.dateOptions, d.date);
    }

    match /gigs/{id} {
      allow read: if isMember();
      allow create: if (isManager() || (isAssistant() && validRequest(id))) && validCall() && validRehearsals() && validDateOptions();
      allow delete: if isManager();
      allow update: if validCall() && rehearsalsOk() && validDateOptions() && (isManager()
        || (isSinger()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['money', 'contract', 'contact', 'dateOptions'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['stage']) || abandons())
          && (wasAbandoned() || request.resource.data.get('call', {}).get('abandoned', false) != true || abandons())));

      function gigNow() {
        return get(/databases/$(database)/documents/gigs/$(id)).data;
      }

      function validUntil(d) {
        return !('until' in d) || (d.until is string && d.until.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
      }

      function signed(d) {
        return d.by == email() && d.at == request.time;
      }

      function validAnswer() {
        let d = request.resource.data;
        return d.keys().hasOnly(['answer', 'by', 'at', 'until'])
          && d.answer in ['yes', 'no', 'later']
          && (d.answer == 'later') == ('until' in d)
          && validUntil(d)
          && ((signed(d) && !('dateOptions' in gigNow())) || carriedOver(d));
      }

      function carriedOver(d) {
        let was = resource.data;
        let gig = getAfter(/databases/$(database)/documents/gigs/$(id)).data;
        return 'dates' in was
          && !('dateOptions' in gig)
          && d.answer == was.dates.get(gig.date, '')
          && d.by == was.by
          && d.at == was.get('times', {}).get(gig.date, was.at)
          && (d.answer != 'later' || d.until == was.until);
      }

      function validDateAnswer() {
        let d = request.resource.data;
        let options = gigNow().get('dateOptions', []);
        return d.keys().hasOnly(['dates', 'times', 'by', 'at', 'until'])
          && d.dates is map
          && d.dates.size() > 0
          && d.dates.keys().hasOnly(options)
          && d.times is map
          && d.times.keys().hasOnly(d.dates.keys())
          && d.dates.keys().hasOnly(d.times.keys())
          && d.dates.values().hasOnly(['yes', 'no', 'later'])
          && ('later' in d.dates.values()) == ('until' in d)
          && validUntil(d)
          && signed(d);
      }

      match /answers/{person} {
        allow read: if isMember();
        allow delete: if isSinger();
        allow create, update: if isSinger() && (validAnswer() || validDateAnswer());
      }

      function validExpense() {
        let d = request.resource.data;
        return d.keys().hasOnly(['kind', 'description', 'amount', 'by', 'at'])
          && d.kind in ['travel', 'meals', 'gear', 'hotel', 'other']
          && d.description is string && d.description.size() <= 120
          && (d.amount is int || d.amount is float) && d.amount > 0 && d.amount <= 100000
          && d.by == email()
          && d.at == request.time;
      }

      match /expenses/{expense} {
        allow read, delete: if isManager();
        allow create, update: if isManager() && validExpense();
      }
    }

    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validTourCall(c) {
      return c is map
        && c.keys().hasOnly(['openedBy', 'openedAt', 'asked', 'subbing'])
        && c.asked is list && c.asked.size() <= 40
        && c.subbing is list && c.subbing.size() <= 40;
    }

    function validTour() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'start', 'end', 'rough', 'places', 'days', 'version', 'covered', 'notCovered', 'perSinger', 'commitBy', 'notes', 'stage', 'call', 'lineup', 'createdAt', 'createdBy'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && isDate(d.start) && isDate(d.end) && d.start <= d.end
        && d.rough is bool
        && d.days is list && d.days.size() <= 62
        && d.version is int
        && d.perSinger is number
        && (d.commitBy == '' || isDate(d.commitBy))
        && d.stage in ['planning', 'committed', 'cancelled']
        && (!('call' in d) || validTourCall(d.call))
        && (!('lineup' in d) || d.lineup is map);
    }

    function validTourAnswer() {
      let d = request.resource.data;
      return d.keys().hasOnly(['answer', 'by', 'at', 'version', 'days', 'until', 'note'])
        && d.answer in ['all', 'some', 'no', 'later']
        && (d.answer == 'some') == ('days' in d)
        && (!('days' in d) || (d.days is list && d.days.size() > 0 && d.days.size() <= 62))
        && (d.answer == 'later') == ('until' in d)
        && (!('until' in d) || isDate(d.until))
        && (!('note' in d) || (d.note is string && d.note.size() <= 200))
        && d.version is int
        && d.by == email()
        && d.at == request.time;
    }

    match /tours/{id} {
      allow read: if isMember();
      allow create, update: if isManager() && validTour();
      allow update: if isMember() && validTour()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['call'])
        && request.resource.data.call.diff(resource.data.call).affectedKeys().hasOnly(['subbing']);
      allow delete: if isManager();

      match /answers/{person} {
        allow read, delete: if isMember();
        allow create, update: if isMember() && validTourAnswer();
      }
    }

    match /contracts/{id} {
      allow read: if isMember();
      allow write: if isManager();
    }

    match /payments/{id} {
      allow read: if isMember();
      allow write: if isManager();
    }

    function validPerson() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'status', 'part', 'phone', 'emails'])
        && d.name is string && d.name.size() <= 120
        && d.status in ['active', 'sub', 'crew', 'alumni']
        && d.part is string && d.part.size() <= 120
        && d.phone is string && d.phone.size() <= 40
        && d.emails is list && d.emails.size() <= 10;
    }

    match /people/{id} {
      allow read: if isMember();
      allow delete: if isManager();
      allow create, update: if isManager() && validPerson();
    }

    function newPresenter() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'email', 'phone', 'techName', 'techEmail', 'techPhone'])
        && short(d.name, 120) && d.name.size() > 0
        && short(d.get('email', ''), 160) && short(d.get('phone', ''), 40)
        && short(d.get('techName', ''), 120) && short(d.get('techEmail', ''), 160) && short(d.get('techPhone', ''), 40);
    }

    function newVenue() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'address']) && d.name is string && d.name.size() > 0 && d.name.size() <= 160 && d.address == '';
    }

    function newTask(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['kind', 'target', 'title', 'open', 'createdBy', 'createdAt'])
        && d.kind in ['venue', 'presenter', 'request']
        && d.target is string && d.target.matches('^[a-z0-9-]+$') && id == d.kind + '-' + d.target
        && d.title is string && d.title.size() <= 200
        && d.open == true && d.createdBy == email() && d.createdAt == request.time
        && (d.kind != 'request' || getAfter(/databases/$(database)/documents/gigs/$(d.target)).data.createdBy == email())
        && (d.kind != 'venue' || existsAfter(/databases/$(database)/documents/venues/$(d.target)))
        && (d.kind != 'presenter' || existsAfter(/databases/$(database)/documents/presenters/$(d.target)));
    }

    match /presenters/{id} {
      allow read: if isMember();
      allow write: if isManager();
      allow create: if isAssistant() && id.matches('^[a-z0-9-]+$') && newPresenter();
    }

    function validTask() {
      let d = request.resource.data;
      let was = resource != null && resource.data.get('kind', '') == 'followup';
      return (d.get('kind', '') != 'followup' && !was) || (
        d.get('kind', '') == 'followup'
        && (resource == null || was)
        && d.keys().hasOnly(['kind', 'reason', 'target', 'title', 'name', 'email', 'due', 'open', 'createdBy', 'createdAt', 'doneBy', 'doneAt', 'snoozedUntil', 'season', 'gig', 'step', 'inquiry', 'phone'])
        && d.reason in ['season', 'reply', 'gig']
        && d.target is string && d.target.size() <= 160
        && d.createdBy is string
        && d.open is bool
        && isDate(d.due)
        && d.name is string && d.name.size() <= 160
        && d.email is string && d.email.size() <= 160
        && d.title is string && d.title.size() <= 400
        && (!('snoozedUntil' in d) || isDate(d.snoozedUntil))
        && (!('step' in d) || d.step in ['quote', 'contract', 'chase', 'decline'])
        && (!('gig' in d) || d.gig is string)
        && (!('inquiry' in d) || d.inquiry is string)
        && (!('phone' in d) || (d.phone is string && d.phone.size() <= 40)));
    }

    match /tasks/{id} {
      allow read: if isMember();
      allow delete: if isManager();
      allow create, update: if isManager() && validTask();
      allow create: if isAssistant() && newTask(id);
    }

    match /venues/{id} {
      allow read: if isMember();
      allow write: if isManager();
      allow create: if isAssistant() && id.matches('^[a-z0-9-]+$') && newVenue();
    }

    function validRehearsal() {
      let d = request.resource.data;
      return d.keys().hasOnly(['date', 'start', 'end', 'place', 'address', 'gigs', 'notes', 'calendarEventId', 'createdBy', 'createdAt'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.start is string && d.start.size() <= 20
        && d.end is string && d.end.size() <= 20
        && d.place is string && d.place.size() <= 160
        && d.address is string && d.address.size() <= 240
        && d.gigs is list && d.gigs.size() <= 10
        && d.notes is string && d.notes.size() <= 2000
        && (!('createdBy' in d) || d.createdBy is string)
        && (!('calendarEventId' in d) || (d.calendarEventId is string && d.calendarEventId.size() <= 1024));
    }

    match /rehearsals/{id} {
      allow read: if isMember();
      allow create, update: if isScheduler() && validRehearsal();
      allow delete: if isScheduler();

      function validReply() {
        let d = request.resource.data;
        return d.keys().hasOnly(['answer', 'by', 'at'])
          && d.answer in ['yes', 'no']
          && d.by == email()
          && d.at == request.time;
      }

      match /replies/{person} {
        allow read: if isMember();
        allow delete: if isSinger();
        allow create, update: if isSinger() && validReply();
      }
    }

    match /events/{id} {
      allow read, create: if isMember();
    }

    match /inquiries/{id} {
      allow read: if isManager();
      allow update: if isManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'handledBy', 'handledAt', 'gig'])
        && request.resource.data.status in ['new', 'replied', 'booked', 'declined', 'spam']
        && request.resource.data.handledBy == email()
        && request.resource.data.handledAt == request.time
        && request.resource.data.get('gig', '') is string;
    }

    function validPushToken() {
      let d = request.resource.data;
      return d.keys().hasOnly(['token', 'email', 'topics', 'device', 'updatedAt'])
        && d.token is string && d.token.size() <= 4096
        && d.email == email()
        && d.topics is list && d.topics.size() <= 10
        && (!d.topics.hasAny(['inquiries']) || isManager())
        && d.device is string && d.device.size() <= 80
        && d.updatedAt == request.time;
    }

    match /pushTokens/{id} {
      allow create, update: if isMember() && validPushToken();
      allow delete: if isMember() && resource.data.email == email();
    }
  }
}
