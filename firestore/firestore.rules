rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(email());
    }

    function isOwner() {
      return signedIn() && email() == 'brett@6minutewarning.com';
    }

    function isMember() {
      return signedIn() && (isOwner() || exists(userDoc()));
    }

    function isManager() {
      return isOwner() || (isMember() && get(userDoc()).data.role in ['admin', 'manager']);
    }

    function isDirector() {
      return isMember() && get(userDoc()).data.role == 'director';
    }

    function isAdmin() {
      return isOwner() || (isMember() && get(userDoc()).data.role == 'admin');
    }

    function isAssistant() {
      return signedIn() && !isOwner() && exists(userDoc()) && get(userDoc()).data.role == 'assistant';
    }

    function isSinger() {
      return isMember() && !isAssistant();
    }

    function validUser() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'role', 'person', 'addedAt', 'addedBy'])
        && (!('person' in d) || (d.person is string && d.person.size() <= 80))
        && d.role in ['admin', 'manager', 'director', 'member', 'assistant']
        && d.name is string && d.name.size() <= 120;
    }

    match /users/{userEmail} {
      allow get: if signedIn() && userEmail == email();
      allow get: if isMember();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && userEmail == userEmail.lower() && validUser()
        && (userEmail != email() || request.resource.data.role == 'admin');
      allow delete: if isAdmin() && userEmail != email();
    }

    function abandons() {
      return request.resource.data.stage == 'cancelled' && request.resource.data.call.abandoned == true;
    }

    function wasAbandoned() {
      return 'call' in resource.data && resource.data.call.abandoned == true;
    }

    function validCall() {
      let c = request.resource.data.call;
      return !('call' in request.resource.data) || (
        c is map
        && c.keys().hasOnly(['openedBy', 'openedAt', 'asked', 'subbing', 'abandoned', 'calendarEventId'])
        && c.asked is list && c.asked.size() <= 40
        && c.subbing is list && c.subbing.size() <= 40
        && c.abandoned is bool
        && c.calendarEventId is string);
    }

    function validRehearsals() {
      let r = request.resource.data.rehearsals;
      return !('rehearsals' in request.resource.data) || (
        r is map
        && r.keys().hasOnly(['needed', 'note', 'by', 'at', 'lineupKey'])
        && r.keys().hasAll(['needed', 'note', 'by', 'at', 'lineupKey'])
        && r.needed is int && r.needed >= 0 && r.needed <= 20
        && r.note is string && r.note.size() <= 200
        && r.by == email()
        && r.at == request.time
        && r.lineupKey is string && r.lineupKey.size() <= 2000);
    }

    function rehearsalsOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rehearsals'])
        || ((isManager() || isDirector()) && 'rehearsals' in request.resource.data && validRehearsals());
    }

    function short(value, max) {
      return value is string && value.size() <= max;
    }

    function isDay(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validRequest(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'date', 'dateOptions', 'time', 'venue', 'stage', 'notes', 'contact', 'money', 'contract', 'performers', 'soundTech', 'sets', 'call', 'createdAt', 'createdBy', 'via'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && isDay(d.date)
        && (!('dateOptions' in d) || validOptions(d.dateOptions, d.date))
        && short(d.time, 80) && short(d.venue, 160) && short(d.notes, 2000) && short(d.sets, 60)
        && d.contact.keys().hasOnly(['name', 'email', 'phone'])
        && short(d.contact.name, 120) && short(d.contact.email, 160) && short(d.contact.phone, 40)
        && d.stage == 'tentative' && d.contract == 'none' && d.performers == [] && d.soundTech == ''
        && d.money.keys().hasOnly(['fee', 'deposit', 'paid', 'merch', 'perSinger'])
        && d.money.fee is int && d.money.fee >= 0 && d.money.perSinger is int && d.money.perSinger >= 0
        && d.money.deposit == 0 && d.money.paid == 0 && d.money.merch == 0
        && d.createdBy == email() && d.createdAt == request.time && d.via == 'assistant'
        && (!('call' in d) || (d.call.openedBy == email() && d.call.abandoned == false && d.call.subbing == []))
        && getAfter(/databases/$(database)/documents/tasks/$('request-' + id)).data.createdAt == request.time;
    }

    function validOptions(o, date) {
      return o is list && o.size() >= 2 && o.size() <= 6 && o[0] == date
        && isDay(o[1]) && (o.size() < 3 || isDay(o[2])) && (o.size() < 4 || isDay(o[3]))
        && (o.size() < 5 || isDay(o[4])) && (o.size() < 6 || isDay(o[5]));
    }

    match /gigs/{id} {
      allow read: if isMember();
      allow create: if (isManager() || (isAssistant() && validRequest(id))) && validCall() && validRehearsals();
      allow delete: if isManager();
      allow update: if validCall() && rehearsalsOk() && (isManager()
        || (isSinger()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['money', 'contract', 'contact'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['stage']) || abandons())
          && (wasAbandoned() || request.resource.data.get('call', {}).get('abandoned', false) != true || abandons())));

      function validAnswer() {
        let d = request.resource.data;
        return d.keys().hasOnly(['answer', 'by', 'at', 'until'])
          && d.answer in ['yes', 'no', 'later']
          && (d.answer == 'later') == ('until' in d)
          && (!('until' in d) || (d.until is string && d.until.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && d.by == email()
          && d.at == request.time;
      }

      match /answers/{person} {
        allow read: if isMember();
        allow delete: if isSinger();
        allow create, update: if isSinger() && validAnswer();
      }

      function validExpense() {
        let d = request.resource.data;
        return d.keys().hasOnly(['kind', 'description', 'amount', 'by', 'at'])
          && d.kind in ['travel', 'meals', 'gear', 'hotel', 'other']
          && d.description is string && d.description.size() <= 120
          && (d.amount is int || d.amount is float) && d.amount > 0 && d.amount <= 100000
          && d.by == email()
          && d.at == request.time;
      }

      match /expenses/{expense} {
        allow read, delete: if isManager();
        allow create, update: if isManager() && validExpense();
      }
    }

    match /contracts/{id} {
      allow read: if isMember();
      allow write: if isManager();
    }

    match /payments/{id} {
      allow read: if isMember();
      allow write: if isManager();
    }

    function validPerson() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'status', 'part', 'phone', 'emails'])
        && d.name is string && d.name.size() <= 120
        && d.status in ['active', 'sub', 'crew', 'alumni']
        && d.part is string && d.part.size() <= 120
        && d.phone is string && d.phone.size() <= 40
        && d.emails is list && d.emails.size() <= 10;
    }

    match /people/{id} {
      allow read: if isMember();
      allow delete: if isManager();
      allow create, update: if isManager() && validPerson();
    }

    function newPresenter() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'email', 'phone', 'techName', 'techEmail', 'techPhone'])
        && short(d.name, 120) && d.name.size() > 0
        && short(d.get('email', ''), 160) && short(d.get('phone', ''), 40)
        && short(d.get('techName', ''), 120) && short(d.get('techEmail', ''), 160) && short(d.get('techPhone', ''), 40);
    }

    function newVenue() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'address']) && d.name is string && d.name.size() > 0 && d.name.size() <= 160 && d.address == '';
    }

    function newTask(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['kind', 'target', 'title', 'open', 'createdBy', 'createdAt'])
        && d.kind in ['venue', 'presenter', 'request']
        && d.target is string && d.target.matches('^[a-z0-9-]+$') && id == d.kind + '-' + d.target
        && d.title is string && d.title.size() <= 200
        && d.open == true && d.createdBy == email() && d.createdAt == request.time
        && (d.kind != 'request' || getAfter(/databases/$(database)/documents/gigs/$(d.target)).data.createdBy == email())
        && (d.kind != 'venue' || existsAfter(/databases/$(database)/documents/venues/$(d.target)))
        && (d.kind != 'presenter' || existsAfter(/databases/$(database)/documents/presenters/$(d.target)));
    }

    match /presenters/{id} {
      allow read: if isMember();
      allow write: if isManager();
      allow create: if isAssistant() && id.matches('^[a-z0-9-]+$') && newPresenter();
    }

    match /tasks/{id} {
      allow read: if isMember();
      allow write: if isManager();
      allow create: if isAssistant() && newTask(id);
    }

    match /venues/{id} {
      allow read: if isMember();
      allow write: if isManager();
      allow create: if isAssistant() && id.matches('^[a-z0-9-]+$') && newVenue();
    }

    match /events/{id} {
      allow read, create: if isMember();
    }
  }
}
