rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(email());
    }

    function isOwner() {
      return signedIn() && email() == 'brett@6minutewarning.com';
    }

    function isMember() {
      return signedIn() && (isOwner() || exists(userDoc()));
    }

    function isManager() {
      return isOwner() || (isMember() && get(userDoc()).data.role in ['admin', 'manager']);
    }

    function isAdmin() {
      return isOwner() || (isMember() && get(userDoc()).data.role == 'admin');
    }

    function validUser() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'role', 'person', 'addedAt', 'addedBy'])
        && (!('person' in d) || (d.person is string && d.person.size() <= 80))
        && d.role in ['admin', 'manager', 'director', 'member']
        && d.name is string && d.name.size() <= 120;
    }

    match /users/{userEmail} {
      allow get: if signedIn() && userEmail == email();
      allow get: if isMember();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && userEmail == userEmail.lower() && validUser()
        && (userEmail != email() || request.resource.data.role == 'admin');
      allow delete: if isAdmin() && userEmail != email();
    }

    match /gigs/{id} {
      allow read: if isMember();
      allow create, delete: if isManager();
      allow update: if isManager()
        || (isMember() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['money', 'contract', 'contact']));
    }

    match /contracts/{id} {
      allow read: if isMember();
      allow write: if isManager();
    }

    match /payments/{id} {
      allow read: if isMember();
      allow write: if isManager();
    }

    function validPerson() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'status', 'part', 'phone', 'emails'])
        && d.name is string && d.name.size() <= 120
        && d.status in ['active', 'sub', 'crew', 'alumni']
        && d.part is string && d.part.size() <= 120
        && d.phone is string && d.phone.size() <= 40
        && d.emails is list && d.emails.size() <= 10;
    }

    match /people/{id} {
      allow read: if isMember();
      allow delete: if isManager();
      allow create, update: if isManager() && validPerson();
    }

    match /venues/{id} {
      allow read: if isMember();
      allow write: if isManager();
    }

    match /events/{id} {
      allow read, create: if isMember();
    }
  }
}
