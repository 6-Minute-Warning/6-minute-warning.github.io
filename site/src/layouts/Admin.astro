---
import "../styles/global.css";
import { Image } from "astro:assets";
import mark from "../assets/brand/Six2Transparent.png";

interface Props {
  title: string;
  role: "home" | "singer" | "manager" | "director" | "stage" | "media";
}

const { title, role } = Astro.props;

const nav = [
  { id: "singer", label: "Singer", href: "/admin/singer/" },
  { id: "manager", label: "Manager", href: "/admin/manager/" },
  { id: "director", label: "Music director", href: "/admin/director/" },
  { id: "stage", label: "Stage", href: "/admin/stage/" },
  { id: "media", label: "Media", href: "/admin/media/" },
];
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | 6MW backstage (mockup)</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <script is:inline>
      try {
        const t = new URLSearchParams(location.search).get("theme") ?? localStorage.getItem("theme");
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body class="admin">
    <p class="mock">Mockup with sample data. Nothing here saves or sends.</p>
    <header class="bar">
      <a class="bar__brand" href="/admin/">
        <Image src={mark} alt="" width={32} height={32} />
        <span>Backstage</span>
      </a>
      <nav aria-label="Dashboards">
        {
          nav.map((n) => (
            <a href={n.href} aria-current={role === n.id ? "page" : undefined}>
              {n.label}
            </a>
          ))
        }
      </nav>
      <a class="bar__site" href="/">View site</a>
    </header>
    <main class="admin__main">
      <slot />
    </main>
    <div class="toast" role="status" aria-live="polite" hidden></div>

    <script>
      const toast = document.querySelector<HTMLElement>(".toast")!;
      let timer: number | undefined;
      document.addEventListener("click", (event) => {
        const target = (event.target as HTMLElement).closest<HTMLElement>("[data-toast]");
        if (!target) return;
        event.preventDefault();
        toast.textContent = target.dataset.toast ?? "";
        toast.hidden = false;
        clearTimeout(timer);
        timer = window.setTimeout(() => (toast.hidden = true), 4000);
      });
    </script>
  </body>
</html>

<style is:global>
  .admin {
    font-size: 0.95rem;
  }

  .mock {
    margin: 0;
    padding: 6px 16px;
    text-align: center;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: var(--color-warning);
    color: var(--color-bg);
  }

  .bar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    padding: 10px var(--gutter);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .bar__brand {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-wordmark, inherit);
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .bar nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .bar nav a {
    padding: 6px 12px;
    border-radius: var(--radius);
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 600;
  }

  .bar nav a:hover {
    color: var(--color-text);
  }

  .bar nav a[aria-current="page"] {
    background: var(--color-surface-raised);
    color: var(--color-text);
    box-shadow: inset 0 -2px 0 var(--color-accent);
  }

  .bar__site {
    margin-left: auto;
    font-size: 0.85rem;
  }

  .admin__main {
    max-width: 1280px;
    margin: 0 auto;
    padding: 28px var(--gutter) 64px;
  }

  .admin h1 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: 4px;
  }

  .admin h2 {
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    margin: 0 0 14px;
  }

  .sub {
    color: var(--color-text-muted);
    margin-bottom: 24px;
  }

  .grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(12, 1fr);
  }

  .card {
    grid-column: span 12;
    min-width: 0;
    padding: 18px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  @media (min-width: 900px) {
    .span-4 {
      grid-column: span 4;
    }

    .span-5 {
      grid-column: span 5;
    }

    .span-6 {
      grid-column: span 6;
    }

    .span-7 {
      grid-column: span 7;
    }

    .span-8 {
      grid-column: span 8;
    }
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    font-size: 0.78rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .chip--ok {
    border-color: var(--color-success);
    color: var(--color-success);
  }

  .chip--warn {
    border-color: var(--color-warning);
    color: var(--color-warning);
  }

  .chip--bad {
    border-color: var(--color-danger);
    color: var(--color-danger);
  }

  .chip--info {
    border-color: var(--color-accent);
    color: var(--color-accent-strong);
  }

  .table-wrap {
    overflow-x: auto;
  }

  .admin table {
    width: 100%;
    border-collapse: collapse;
  }

  .admin th,
  .admin td {
    padding: 9px 10px;
    text-align: left;
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }

  .admin th {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    font-weight: 700;
  }

  .muted {
    color: var(--color-text-muted);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .list > li {
    padding: 10px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .list > li:last-child {
    border-bottom: 0;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .mini-btn {
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 5px 10px;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--color-surface-raised);
    color: var(--color-text);
    cursor: pointer;
    text-decoration: none;
  }

  .mini-btn:hover {
    border-color: var(--color-accent);
  }

  .mini-btn[aria-pressed="true"] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .stat {
    display: grid;
    gap: 2px;
  }

  .stat strong {
    font-size: 1.6rem;
    font-weight: 800;
    font-stretch: 112%;
  }

  .stats {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  }

  .toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    translate: -50% 0;
    z-index: 50;
    max-width: min(560px, calc(100vw - 32px));
    padding: 12px 16px;
    border-radius: var(--radius);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-accent);
    box-shadow: 0 8px 30px var(--color-scrim);
    font-weight: 600;
  }
</style>
