---
import "../styles/global.css";
import { getImage } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ThemePicker from "../components/ThemePicker.astro";
import { site } from "../data/site";
import { members } from "../data/members";
import liveSixWide from "../assets/photos/live-six-wide.jpg";
import mark from "../assets/brand/Six2Transparent.png";

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
  schema?: object[];
  noindex?: boolean;
}

const { title, description = site.description, image = liveSixWide, schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = await getImage({ src: image, width: 1200, height: 630, fit: "cover", format: "jpg" });
const ogImageUrl = new URL(ogImage.src, site.url).href;
const logo = await getImage({ src: mark, width: 432, format: "png" });

const band = {
  "@context": "https://schema.org",
  "@type": "MusicGroup",
  "@id": `${site.url}/#band`,
  name: site.name,
  url: site.url,
  logo: new URL(logo.src, site.url).href,
  image: ogImageUrl,
  description: site.description,
  genre: ["A cappella", "Pop", "R&B"],
  foundingLocation: { "@type": "Place", name: `${site.city}, ${site.region}` },
  areaServed: [
    { "@type": "City", name: site.city },
    { "@type": "State", name: site.region },
  ],
  sameAs: site.socials.map((s) => s.url),
  member: members.map((m) => ({ "@type": "Person", name: m.name, jobTitle: m.role })),
};
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_CA" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify([band, ...schema])} />
    <script is:inline>
      try {
        const t = new URLSearchParams(location.search).get("theme") ?? localStorage.getItem("theme");
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ThemePicker />
    <script>
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
        const targets = [...document.querySelectorAll(".section > .wrap > :not(.members):not(.shows):not(.quotes), .members > *, .shows li, .quotes figure")];
        for (const el of targets) el.setAttribute("data-reveal", "");
        document.documentElement.classList.add("js-motion");
        const show = (el: Element) => el.classList.add("is-in");
        const seen = new IntersectionObserver((entries, obs) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            show(entry.target);
            obs.unobserve(entry.target);
          }
        }, { rootMargin: "0px 0px 15% 0px" });
        for (const el of targets) seen.observe(el);
        // Nothing stays hidden: anything unrevealed after the first scroll-through shows anyway.
        setTimeout(() => { for (const el of targets) show(el); }, 4000);
        addEventListener("pagehide", () => { for (const el of targets) show(el); });
      }
    </script>
  </body>
</html>
