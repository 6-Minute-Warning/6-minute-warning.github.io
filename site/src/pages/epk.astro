---
import { Image, getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import Video from "../components/Video.astro";
import Testimonials from "../components/Testimonials.astro";
import { site, videos, highlights } from "../data/site";
import sixOnStage from "../assets/photos/press-six-on-stage.jpg";
import sixFullLength from "../assets/photos/press-six-full-length.jpg";
import sixBlackAndWhite from "../assets/photos/press-six-black-and-white.jpg";
import trio from "../assets/photos/press-trio.jpg";
import brettJacket from "../assets/photos/press-brett-6-jacket.jpg";
import stackedOnLight from "../assets/brand/press/logo-stacked-on-light.png";
import stackedOnDark from "../assets/brand/press/logo-stacked-on-dark.png";
import horizontalOnLight from "../assets/brand/press/logo-horizontal-on-light.png";
import horizontalOnDark from "../assets/brand/press/logo-horizontal-on-dark.png";
import markOnLight from "../assets/brand/press/mark-on-light.png";
import markOnDark from "../assets/brand/press/mark-on-dark.png";

const photoSources = [
  { src: sixOnStage, name: "group-on-stage" },
  { src: sixFullLength, name: "group-full-length" },
  { src: sixBlackAndWhite, name: "group-black-and-white" },
  { src: trio, name: "trio-brett-bryan-and-taylor" },
  { src: brettJacket, name: "brett-from-behind-in-the-6-jacket" },
];

const photos = await Promise.all(
  photoSources.map(async (p) => ({
    ...p,
    full: await getImage({ src: p.src, width: Math.min(2400, p.src.width), format: "jpg", quality: 90 }),
  })),
);

const logos = [
  { src: horizontalOnLight, name: "Horizontal", ground: "light", pdf: "/brand/6mw-logo-horizontal-on-light.pdf" },
  { src: horizontalOnDark, name: "Horizontal", ground: "dark", pdf: "/brand/6mw-logo-horizontal-on-dark.pdf" },
  { src: stackedOnLight, name: "Stacked", ground: "light", pdf: "/brand/6mw-logo-stacked-on-light.pdf" },
  { src: stackedOnDark, name: "Stacked", ground: "dark", pdf: "/brand/6mw-logo-stacked-on-dark.pdf" },
  { src: markOnLight, name: "Mark", ground: "light", pdf: "/brand/6mw-mark-on-light.pdf" },
  { src: markOnDark, name: "Mark", ground: "dark", pdf: "/brand/6mw-mark-on-dark.pdf" },
];

const shortBio =
  "6 Minute Warning is a six-voice a cappella group from Edmonton, Alberta. They perform pop and R&B with influences from Take 6, Boyz II Men and NSYNC, and their shows are known for high energy, spontaneity and humour. The group has backed Ben Folds with the Edmonton Symphony Orchestra, placed in the top five of David Foster's Star Search, and performed alongside Glass Tiger.";
---

<Base
  title="Press Kit | 6 Minute Warning"
  description="Electronic press kit for 6 Minute Warning, Edmonton a cappella group: bio, performance highlights, videos, audio, press photos and logos."
>
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Electronic press kit</span>
      <h1>6 Minute Warning</h1>
      <p class="actions">
        <a class="btn" href={site.mediaKitUrl}>Download media package</a>
        <a class="btn btn--ghost" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <p class="note">The media package includes MP3s, photos, logo versions and press info.</p>
    </div>
  </section>

  <section class="section section--raised">
    <div class="wrap two-col">
      <div>
        <span class="eyebrow">Bio</span>
        <h2>Short bio</h2>
        <p class="bio">{shortBio}</p>
      </div>
      <div>
        <span class="eyebrow">Highlights</span>
        <h2>Performance highlights</h2>
        <ul class="highlights">
          {highlights.map((h) => <li>{h}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Watch and listen</span>
      <h2>Videos and audio</h2>
      <div class="videos">
        {videos.map((v) => <Video id={v.id} title={v.title} />)}
      </div>
      <iframe
        class="soundcloud"
        title="6 Minute Warning on SoundCloud"
        loading="lazy"
        allow="autoplay"
        src={`https://w.soundcloud.com/player/?url=${encodeURIComponent(site.soundcloudPlaylist)}&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&visual=false`}
      ></iframe>
    </div>
  </section>

  <section class="section section--raised">
    <div class="wrap">
      <span class="eyebrow">Press photos</span>
      <h2>Photos</h2>
      <p class="note">Click a photo to download it at full size. Photos and logos are free to use when promoting a 6 Minute Warning show.</p>
      <ul class="photos">
        {
          photos.map((p) => (
            <li>
              <a href={p.full.src} download={`6-minute-warning-${p.name}.jpg`}>
                <Image src={p.src} alt={`6 Minute Warning press photo: ${p.name.replaceAll("-", " ")}`} widths={[360, 600]} sizes="(min-width: 900px) 30vw, 50vw" />
              </a>
            </li>
          ))
        }
      </ul>
      <h3>Logos</h3>
      <ul class="logos">
        {
          logos.map((l) => (
            <li class={`logo logo--${l.ground}`}>
              <div class="logo__frame">
                <Image src={l.src} alt={`6 Minute Warning ${l.name.toLowerCase()} logo for ${l.ground} backgrounds`} widths={[240, 480]} sizes="240px" />
              </div>
              <p class="logo__name">{l.name}, {l.ground} background</p>
              <p class="logo__files">
                <a href={l.src.src} download>PNG</a>
                <a href={l.pdf} download>PDF (vector)</a>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Press</span>
      <h2>What people say</h2>
      <Testimonials />
    </div>
  </section>
</Base>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .note {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .two-col {
    display: grid;
    gap: 48px;
  }

  @media (min-width: 900px) {
    .two-col {
      grid-template-columns: 1fr 1fr;
    }
  }

  .bio {
    font-size: 1.1rem;
  }

  .highlights {
    margin: 0;
    padding-left: 1.2em;
    color: var(--color-text-muted);
  }

  .highlights li {
    margin-bottom: 0.5em;
  }

  .highlights li::marker {
    color: var(--color-accent);
  }

  .videos {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }

  .soundcloud {
    width: 100%;
    height: 360px;
    margin-top: 32px;
    border: 0;
    border-radius: var(--radius);
  }

  .photos,
  .logos {
    list-style: none;
    margin: 24px 0 48px;
    padding: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }

  .photos :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
    transition: opacity 0.2s;
  }

  .photos a:hover :global(img) {
    opacity: 0.8;
  }

  .logo {
    display: grid;
    gap: 10px;
    padding: 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .logo__frame {
    position: relative;
    aspect-ratio: 3 / 2;
    border-radius: calc(var(--radius) - 2px);
  }

  .logo--light .logo__frame {
    background: var(--color-paper);
  }

  .logo--dark .logo__frame {
    background: var(--color-bg);
  }

  .logo__frame :global(img) {
    position: absolute;
    inset: 12%;
    width: 76%;
    height: 76%;
    object-fit: contain;
  }

  .logo__name {
    margin: 0;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .logo__files {
    margin: 0;
    display: flex;
    gap: 16px;
    font-size: 0.85rem;
  }
</style>
