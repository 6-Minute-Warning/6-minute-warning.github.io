---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Stages from "../components/Stages.astro";
import Video from "../components/Video.astro";
import MemberCard from "../components/MemberCard.astro";
import Testimonials from "../components/Testimonials.astro";
import Shows from "../components/Shows.astro";
import NextShow from "../components/NextShow.astro";
import { upcomingShows } from "../data/shows";
import { site, videos } from "../data/site";
import { members } from "../data/members";
import { services } from "../data/services";
import backstageBw from "../assets/photos/backstage-bw-wide.jpg";

const showSchema = upcomingShows()
  .filter((s) => s.public)
  .map((s) => ({
    "@context": "https://schema.org",
    "@type": "MusicEvent",
    name: s.title,
    startDate: s.start,
    eventStatus: "https://schema.org/EventScheduled",
    eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
    location: { "@type": "Place", name: s.venue ?? s.city, address: s.city },
    performer: { "@id": `${site.url}/#band` },
    ...(s.url ? { offers: { "@type": "Offer", url: s.url } } : {}),
  }));
---

<Base title="6 Minute Warning | A Cappella Group from Edmonton, Alberta" schema={showSchema}>
  <Hero image={backstageBw} alt="6 Minute Warning walking off stage in a line, shot from behind in black and white" position="center 8%" eyebrow="A cappella from Edmonton" tall>
    <h1>Six voices. No instruments.</h1>
    <p class="lede">We sing pop and R&B with nothing but our voices, with influences from Take 6, Boyz II Men and NSYNC. Every show is loud, loose and a little unpredictable.</p>
    <div class="actions">
      <a class="btn" href="#watch">Watch us</a>
      <a class="btn btn--ghost" href="/book/">Book us</a>
    </div>
    <NextShow />
  </Hero>

  <Stages />

  <Shows />

  <section class="section" id="watch">
    <div class="wrap">
      <span class="eyebrow">Watch</span>
      <h2>Hear it for yourself</h2>
      <div class="videos">
        {videos.map((v) => <Video id={v.id} title={v.title} />)}
      </div>
      <p class="more">
        {site.socials.map((s) => <a href={s.url} rel="me noopener" target="_blank">{s.label} →</a>)}
      </p>
    </div>
  </section>

  <section class="section section--raised">
    <div class="wrap">
      <span class="eyebrow">The band</span>
      <h2>Meet the six</h2>
      <div class="members">
        {members.map((m) => <MemberCard member={m} />)}
      </div>
      <p class="more"><a href="/about/">Read the bios →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <Testimonials />
    </div>
  </section>

  <section class="section section--raised">
    <div class="wrap booking">
      <div>
        <span class="eyebrow">Booking</span>
        <h2>Bring us to your event</h2>
        <p class="lede">No instruments means no load-in: on stage in seconds, off in seconds, and room for six people is all we need.</p>
        <a class="btn" href="/book/">Check your date</a>
      </div>
      <ul class="booking__types">
        {services.map((s) => <li><a href={`/${s.slug}/`}>{s.nav}<span aria-hidden="true">→</span></a></li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .videos {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }

  .members {
    display: grid;
    gap: 24px 16px;
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 700px) {
    .members {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .more {
    margin-top: 32px;
    font-weight: 700;
  }

  .more {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  .more a {
    text-decoration: none;
  }

  .booking {
    display: grid;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .booking {
      grid-template-columns: 1fr 1fr;
    }
  }

  .booking .lede {
    margin-bottom: 28px;
  }

  .booking__types {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .booking__types a {
    display: flex;
    justify-content: space-between;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 700;
    font-stretch: 112%;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .booking__types a:hover {
    color: var(--color-accent-strong);
  }

  .booking__types span {
    color: var(--color-accent-strong);
  }
</style>
