---
import { site } from "../data/site";
import { services } from "../data/services";
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__grid">
    <div>
      <p class="footer__name">6 Minute Warning</p>
      <p class="footer__meta">A cappella from {site.city}, {site.region}.</p>
    </div>
    <nav aria-label="Events">
      <p class="footer__head">Book Us For</p>
      <ul>
        {services.map((s) => <li><a href={`/${s.slug}/`}>{s.nav}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Band">
      <p class="footer__head">The Band</p>
      <ul>
        <li><a href="/about/">Members</a></li>
        <li><a href="/epk/">Press Kit</a></li>
        <li><a href="/book/">Booking inquiry</a></li>
      </ul>
    </nav>
    <nav aria-label="Social">
      <p class="footer__head">Follow</p>
      <ul>
        {site.socials.map((s) => <li><a href={s.url} rel="me noopener" target="_blank">{s.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="wrap footer__legal">© {year} 6 Minute Warning</div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding: 56px 0 32px;
    font-size: 0.95rem;
  }

  .footer__grid {
    display: grid;
    gap: 32px;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  }

  .footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer li {
    margin-bottom: 0.4em;
  }

  .footer a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--color-text);
  }

  .footer__name {
    font-weight: 800;
    font-stretch: 125%;
    text-transform: uppercase;
    margin-bottom: 0.3em;
  }

  .footer__meta {
    color: var(--color-text-muted);
  }

  .footer__head {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent-strong);
  }

  .footer__legal {
    margin-top: 40px;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }
</style>
