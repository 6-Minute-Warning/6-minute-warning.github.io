---
import { stages } from "../data/site";
---

<section class="stages" aria-labelledby="stages-label">
  <div class="wrap">
    <p class="stages__label" id="stages-label">Where you have heard us</p>
    <ul>
      {
        stages.map((s) => (
          <li>
            <strong>{s.title}</strong>
            <span>{s.detail}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .stages {
    border-bottom: 1px solid var(--color-border);
    padding: 40px 0 48px;
  }

  .stages__label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent-strong);
    margin-bottom: 20px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  @media (min-width: 440px) {
    ul {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    ul {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  li {
    display: grid;
    align-content: start;
    gap: 6px;
    min-width: 0;
    padding: 16px;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  strong {
    font-weight: 800;
    font-stretch: 118%;
    text-transform: uppercase;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.15;
  }

  span {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.4;
  }
</style>
