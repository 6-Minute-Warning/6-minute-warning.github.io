---
import { Image } from "astro:assets";
import type { Member } from "../data/members";

interface Props {
  member: Member;
  link?: boolean;
}

const { member, link = true } = Astro.props;
const Tag = link ? "a" : "div";
---

<Tag class="member" href={link ? `/about/#${member.slug}` : undefined}>
  <div class="member__photos">
    <Image src={member.profile} alt={`${member.name} of 6 Minute Warning singing on stage`} widths={[320, 480, 640]} sizes="(min-width: 900px) 30vw, 50vw" class="member__profile" />
  </div>
  <p class="member__name">{member.name}</p>
</Tag>

<style>
  .member {
    display: block;
    color: var(--color-text);
    text-decoration: none;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .member:hover,
  .member:focus-visible {
    transform: translateY(-4px);
  }

  .member__photos :global(img) {
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .member:hover .member__photos :global(img) {
    transform: scale(1.04);
  }

  .member__photos {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .member__photos :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
  }

  .member__name {
    margin: 12px 0 0;
    font-weight: 800;
    font-stretch: 118%;
    text-transform: uppercase;
    line-height: 1.2;
  }
</style>
