---
import type { Faq } from "../data/services";

interface Props {
  faqs: Faq[];
}

const { faqs } = Astro.props;
---

<div class="faq">
  {
    faqs.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--color-border);
  }

  details {
    border-bottom: 1px solid var(--color-border);
  }

  summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    font-weight: 700;
    font-size: 1.1rem;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: "+";
    color: var(--color-accent-strong);
    font-size: 1.5rem;
    line-height: 1;
  }

  details[open] summary::after {
    content: "−";
  }

  details p {
    margin: 0 0 20px;
    color: var(--color-text-muted);
    max-width: 70ch;
  }
</style>
