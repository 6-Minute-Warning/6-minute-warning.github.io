{
  "name": "6mw",
  "private": true,
  "workspaces": [
    "theme",
    "site",
    "app",
    "firestore",
    "functions"
  ],
  "scripts": {
    "dev:site": "npm run dev -w @6mw/site",
    "dev:app": "npm run dev -w @6mw/app",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check -w @6mw/site && npm run type-check -w @6mw/app && npm run type-check -w @6mw/functions",
    "test": "npm run test:unit -w @6mw/app -- --run",
    "test:rules": "npm test -w @6mw/firestore && npm test -w @6mw/functions"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "packageManager": "npm@11.19.1",
  "devDependencies": {
    "@types/node": "^24.13.4",
    "firebase-tools": "^15.30.2",
    "typescript": "~5.9.0",
    "vitest": "^4.1.11"
  }
}
