---
import { stages } from "../data/site";
---

<section class="stages" aria-label="Credits">
  <div class="wrap">
    <p class="stages__label">Where you have heard us</p>
    <ul>
      {stages.map((s) => <li>{s}</li>)}
    </ul>
  </div>
</section>

<style>
  .stages {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 28px 0;
  }

  .stages__label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent-strong);
    margin-bottom: 12px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
  }

  li {
    font-weight: 700;
    font-stretch: 112%;
    text-transform: uppercase;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
</style>
