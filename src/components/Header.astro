---
import { Image } from "astro:assets";
import mark from "../assets/brand/Six2Transparent.png";
import { services } from "../data/services";
---

<header class="header">
  <div class="wrap header__inner">
    <a class="brand" href="/" aria-label="6 Minute Warning home">
      <Image src={mark} alt="" width={44} height={44} loading="eager" />
      <span class="brand__name"><span>Minute</span><span>Warning</span></span>
    </a>
    <div class="menu">
      <button class="menu__toggle" type="button" aria-expanded="false" aria-controls="menu-panel">Menu</button>
      <nav class="menu__panel" id="menu-panel" aria-label="Main">
        <ul class="menu__main">
          <li><a href="/#watch">Watch</a></li>
          <li><a href="/about/">The band</a></li>
          <li class="menu__group">
            <a class="menu__group-link" href="/events/">Events</a>
            <ul class="menu__events">
              {services.map((s) => <li><a href={`/${s.slug}/`}>{s.nav}</a></li>)}
            </ul>
          </li>
          <li><a href="/epk/">Press kit</a></li>
          <li><a class="btn menu__cta" href="/book/">Book us</a></li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu__toggle");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-scrim);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 68px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--color-text);
    text-decoration: none;
  }

  .brand img {
    width: 44px;
    height: 44px;
  }

  .brand__name {
    display: grid;
    font-family: var(--font-wordmark);
    font-weight: 300;
    text-transform: uppercase;
    font-size: 1.05rem;
    line-height: 1.05;
    letter-spacing: 0.02em;
    color: var(--color-accent-strong);
    white-space: nowrap;
  }

  .brand__name span + span {
    padding-left: 0.45em;
  }

  .menu__toggle {
    cursor: pointer;
    background: none;
    color: var(--color-text);
    font: inherit;
    padding: 0.5em 0.9em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
  }

  .menu__panel {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: 16px var(--gutter) 24px;
  }

  .menu__toggle[aria-expanded="true"] + .menu__panel {
    display: block;
  }

  .menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu a:not(.btn) {
    display: block;
    padding: 0.6em 0;
    color: var(--color-text);
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
  }

  .menu a:not(.btn):hover {
    color: var(--color-accent-strong);
  }

  .menu .menu__events {
    padding-left: 16px;
    border-left: 1px solid var(--color-border);
    margin-bottom: 8px;
  }

  .menu .menu__events a {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .menu__cta {
    margin-top: 12px;
  }

  @media (min-width: 900px) {
    .menu__toggle {
      display: none;
    }

    .menu__panel,
    .menu__toggle[aria-expanded="true"] + .menu__panel {
      position: static;
      display: flex;
      background: none;
      border: 0;
      padding: 0;
    }

    .menu__main {
      display: flex;
      align-items: center;
      gap: 26px;
    }

    .menu a:not(.btn) {
      font-size: 0.95rem;
    }

    .menu__group {
      position: relative;
    }

    .menu__group-link::after {
      content: " ▾";
      color: var(--color-accent-strong);
    }

    .menu .menu__events {
      display: none;
      position: absolute;
      top: 100%;
      left: -20px;
      min-width: 220px;
      padding: 8px 20px;
      margin: 0;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
    }

    .menu__group:hover .menu__events,
    .menu__group:focus-within .menu__events {
      display: block;
    }

    .menu__cta {
      margin: 0;
      padding: 0.7em 1.2em;
    }
  }
</style>
